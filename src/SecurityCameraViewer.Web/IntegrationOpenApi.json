    "/detections": {
      "get": {
        "summary": "Read current detector observations and buffered overlay history",
        "description": "Requires read or admin scope. Also available at /api/detections. No model paths, settings or extra inference. Current detections expire in wall time; history retains timestamped samples including empty results for buffered playback. Configuration ID identifies the active camera collection. Use since with the previous generatedAt to request new publications; deduplicate inclusive boundaries and clear history when its id changes.",
        "x-required-scope": "read",
        "parameters": [{ "name": "since", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" }, "description": "Inclusive publication cursor from a previous generatedAt; omit for the retained history." }],
        "responses": {
          "200": {
            "description": "Current observations (empty when no detection workers are enabled)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "configurationId": { "type": "string" },
                    "generatedAt": { "type": "string", "format": "date-time" },
                    "historySeconds": { "type": "number", "exclusiveMinimum": 0 },
                    "maximumHistorySamples": { "type": "integer", "minimum": 1 },
                    "enabled": { "type": "boolean" },
                    "methods": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "shortName": { "type": "string" } } } },
                    "models": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
                    "cameras": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "channel": { "type": "integer" },
                          "status": { "type": "string" },
                          "history": {
                            "type": "object",
                            "properties": {
                              "id": { "type": "string" },
                              "frames": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "capturedAt": { "type": "string", "format": "date-time" },
                                    "publishedAt": { "type": "string", "format": "date-time" },
                                    "detections": { "type": "array", "items": { "$ref": "#/components/schemas/DetectionObservation" } }
                                  }
                                }
                              }
                            }
                          },
                          "detections": {
                            "type": "array", "maxItems": 128,
                            "items": {
                              "type": "object",
                              "properties": {
                                "observation": { "$ref": "#/components/schemas/DetectionObservation" },
                                "ageSeconds": { "type": "number", "minimum": 0 },
                                "remainingSeconds": { "type": "number", "minimum": 0 }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid publication cursor" },
          "401": { "description": "Missing, expired or revoked token" },
          "403": { "description": "Insufficient scope" }
        }
      }
    },
